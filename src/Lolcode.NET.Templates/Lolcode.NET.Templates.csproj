<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageType>Template</PackageType>
    <PackageId>Lolcode.NET.Templates</PackageId>
    <PackageDescription>Project and file templates for LOLCODE .NET applications. Install with: dotnet new install Lolcode.NET.Templates</PackageDescription>
    <PackageTags>lolcode;template;dotnet-new</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mattleibow/dotnet-lolcode</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Stamp the SDK version into templates that require the LOLCODE SDK before packing. -->
  <Target Name="StampSdkVersion" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_ConsoleProjectTemplate>$(MSBuildProjectDirectory)\templates\lolcode-console\LolcodeApp.lolproj</_ConsoleProjectTemplate>
      <_FileBasedAppTemplate>$(MSBuildProjectDirectory)\templates\lolcode-file\Program.lol</_FileBasedAppTemplate>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(_ConsoleProjectTemplate)"
      Lines="$([System.IO.File]::ReadAllText('$(_ConsoleProjectTemplate)').Replace('LolcodeSdkVersion','$(Version)'))"
      Overwrite="true" />
    <WriteLinesToFile
      File="$(_FileBasedAppTemplate)"
      Lines="$([System.IO.File]::ReadAllText('$(_FileBasedAppTemplate)').Replace('LolcodeSdkVersion','$(Version)'))"
      Overwrite="true" />
  </Target>

  <!-- Restore the placeholder after packing so source stays clean -->
  <Target Name="RestoreSdkVersionPlaceholder" AfterTargets="Pack">
    <PropertyGroup>
      <_ConsoleProjectTemplate>$(MSBuildProjectDirectory)\templates\lolcode-console\LolcodeApp.lolproj</_ConsoleProjectTemplate>
      <_FileBasedAppTemplate>$(MSBuildProjectDirectory)\templates\lolcode-file\Program.lol</_FileBasedAppTemplate>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(_ConsoleProjectTemplate)"
      Lines="$([System.IO.File]::ReadAllText('$(_ConsoleProjectTemplate)').Replace('$(Version)','LolcodeSdkVersion'))"
      Overwrite="true" />
    <WriteLinesToFile
      File="$(_FileBasedAppTemplate)"
      Lines="$([System.IO.File]::ReadAllText('$(_FileBasedAppTemplate)').Replace('$(Version)','LolcodeSdkVersion'))"
      Overwrite="true" />
  </Target>

</Project>
