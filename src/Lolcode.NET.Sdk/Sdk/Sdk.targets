<!--
  Lolcode.NET.Sdk - Sdk.targets

  Imported at the BOTTOM of every .lolproj file.
  Defines CoreCompile override and imports the base .NET SDK targets.
-->
<Project>

  <!-- Import .NET SDK targets first — gives us publish, pack, clean, run, etc. -->
  <!-- Setting Language=LOLCODE means it won't find Microsoft.LOLCODE.targets, which is fine -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!--
    Defaults are declared in Sdk.props so project bodies can Update or Remove
    them. Reconcile them after the project body: an explicit Include wins over
    the same implicit identity, and opt-out/source-library builds remove only
    the implicit defaults.
  -->
  <Target Name="_ConfigureDefaultLolcodeLibraryPackages"
          BeforeTargets="CollectPackageReferences">
    <ItemGroup>
      <_LolcodeExplicitProviderPackageReference Include="@(PackageReference)"
          Condition="'%(PackageReference.LolcodeDefaultProvider)' != 'true' and ('%(PackageReference.Identity)' == 'Lolcode.Runtime.String' or '%(PackageReference.Identity)' == 'Lolcode.Runtime.Stdlib' or '%(PackageReference.Identity)' == 'Lolcode.Runtime.Stdio' or '%(PackageReference.Identity)' == 'Lolcode.Runtime.Socks')" />
      <PackageReference Remove="@(_LolcodeExplicitProviderPackageReference)" />
      <PackageReference Include="@(_LolcodeExplicitProviderPackageReference)" />
      <PackageReference Update="@(PackageReference)"
          Condition="'%(PackageReference.LolcodeDefaultProvider)' == 'true' and '$(LolcodeRuntimePackageVersion)' != '$(_LolcodeDefaultRuntimePackageVersion)'">
        <Version>$(LolcodeRuntimePackageVersion)</Version>
      </PackageReference>
      <PackageReference Remove="@(PackageReference)"
          Condition="'%(PackageReference.LolcodeDefaultProvider)' == 'true' and ('$(LolcodeUseDefaultLibraries)' != 'true' or '$(LolcodeUseSourceLibraries)' == 'true')" />
    </ItemGroup>
  </Target>

  <!-- Resolve the compiler task assembly location -->
  <PropertyGroup>
    <_LolcodeBuildTasksDir Condition=" '$(_LolcodeBuildTasksDir)' == '' ">$(MSBuildThisFileDirectory)..\tools\net10.0\</_LolcodeBuildTasksDir>
    <LolcodeRuntimeAssemblyPath Condition=" '$(LolcodeRuntimeAssemblyPath)' == '' ">$(_LolcodeBuildTasksDir)Lolcode.Runtime.dll</LolcodeRuntimeAssemblyPath>
    <_LolcodeCompilerOptionsFile>$(IntermediateOutputPath)Lolcode.CompilerOptions.cache</_LolcodeCompilerOptionsFile>
  </PropertyGroup>

  <!-- Register the compiler task -->
  <UsingTask TaskName="Lolcode.Build.Lolc"
             AssemblyFile="$(_LolcodeBuildTasksDir)Lolcode.Build.dll" />
  <UsingTask TaskName="Lolcode.Build.MakeValidClrIdentifier"
             AssemblyFile="$(_LolcodeBuildTasksDir)Lolcode.Build.dll" />

  <!-- Add Lolcode.Runtime as a reference so it appears in deps.json and gets copied -->
  <ItemGroup>
    <Reference Include="Lolcode.Runtime">
      <HintPath>$(LolcodeRuntimeAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    CreateManifestResourceNames: Required by Microsoft.Common.targets for embedded resources.
    LOLCODE doesn't have embedded resources, so this is a no-op.
  -->
  <Target Name="CreateManifestResourceNames" />

  <Target Name="_PrepareLolcodeLibraryTypeName"
          BeforeTargets="CoreCompile">
    <MakeValidClrIdentifier Condition="'$(OutputType)' == 'Library' and '$(LolcodeLibraryTypeName)' == ''"
                            Input="$(AssemblyName)">
      <Output TaskParameter="Identifier" PropertyName="LolcodeLibraryTypeName" />
    </MakeValidClrIdentifier>

    <MakeValidClrIdentifier Condition="'$(OutputType)' == 'Library'"
                            Input="$(LolcodeLibraryTypeName)">
      <Output TaskParameter="Identifier" PropertyName="_LolcodeValidatedLibraryTypeName" />
    </MakeValidClrIdentifier>

    <Error Condition="'$(OutputType)' == 'Library' and '$(_LolcodeValidatedLibraryTypeName)' != '$(LolcodeLibraryTypeName)'"
           Text="LolcodeLibraryTypeName must be a simple, non-keyword CLR/C# identifier without dots. Set RootNamespace to the desired namespace." />

    <!-- Normalize each explicit or derived namespace component independently. -->
    <PropertyGroup Condition="'$(OutputType)' == 'Library'">
      <_LolcodeEffectiveRootNamespace Condition="'$(RootNamespace)' != ''">$(RootNamespace)</_LolcodeEffectiveRootNamespace>
      <_LolcodeEffectiveRootNamespace Condition="'$(_LolcodeEffectiveRootNamespace)' == ''">$(AssemblyName)</_LolcodeEffectiveRootNamespace>
    </PropertyGroup>

    <ItemGroup Condition="'$(OutputType)' == 'Library' and '$(_LolcodeEffectiveRootNamespace)' != ''">
      <_LolcodeRootNamespaceSegment Include="$([System.String]::Copy('$(_LolcodeEffectiveRootNamespace)').Split('.'))" />
    </ItemGroup>

    <MakeValidClrIdentifier Condition="'$(OutputType)' == 'Library' and '@(_LolcodeRootNamespaceSegment)' != ''"
                            Input="%(_LolcodeRootNamespaceSegment.Identity)">
      <Output TaskParameter="Identifier" ItemName="_LolcodeSanitizedRootNamespaceSegment" />
    </MakeValidClrIdentifier>

    <PropertyGroup Condition="'$(OutputType)' == 'Library'">
      <_LolcodeSanitizedRootNamespace>@(_LolcodeSanitizedRootNamespaceSegment, '.')</_LolcodeSanitizedRootNamespace>
      <_LolcodeLibraryFullTypeName
          Condition="'$(_LolcodeSanitizedRootNamespace)' != ''">$(_LolcodeSanitizedRootNamespace).$(LolcodeLibraryTypeName)</_LolcodeLibraryFullTypeName>
      <_LolcodeLibraryFullTypeName
          Condition="'$(_LolcodeLibraryFullTypeName)' == ''">$(LolcodeLibraryTypeName)</_LolcodeLibraryFullTypeName>
    </PropertyGroup>

    <PropertyGroup>
      <_LolcodeLibraryDescriptorStamp>@(LolcodeLibrary, ';')</_LolcodeLibraryDescriptorStamp>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_LolcodeCompilerOptionsFile)"
                      Lines="OutputType=$(OutputType);AssemblyName=$(AssemblyName);RootNamespace=$(_LolcodeSanitizedRootNamespace);LolcodeLibraryTypeName=$(LolcodeLibraryTypeName);LolcodeLibraryFullTypeName=$(_LolcodeLibraryFullTypeName);LolcodeLibraries=$(_LolcodeLibraryDescriptorStamp)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <!--
    Override CoreCompile — this is the target called by the .NET SDK to compile source code.
    We replace the default C# Csc task with our Lolc task.

    Inputs/Outputs enable incremental builds: MSBuild skips this target if all
    outputs are newer than all inputs.
  -->
  <Target Name="CoreCompile"
          Condition=" '@(Compile)' != '' "
          DependsOnTargets="$(CoreCompileDependsOn)"
          Inputs="@(Compile);@(CustomAdditionalCompileInputs);@(ReferencePathWithRefAssemblies);$(MSBuildAllProjects);$(_LolcodeCompilerOptionsFile)"
          Outputs="@(IntermediateAssembly)">

    <!-- Filter out any non-.lol files (e.g., auto-generated .cs files from file-based apps) -->
    <ItemGroup>
      <_LolSources Include="@(Compile)" Condition="'%(Extension)' == '.lol'" />
    </ItemGroup>

    <Lolc Sources="@(_LolSources)"
          ReferencePath="@(ReferencePathWithRefAssemblies)"
          OutputAssembly="@(IntermediateAssembly)"
          RuntimeAssemblyPath="$(LolcodeRuntimeAssemblyPath)"
          OutputType="$(OutputType)"
          AssemblyName="$(AssemblyName)"
          LolcodeLibraryTypeName="$(_LolcodeLibraryFullTypeName)"
          LolcodeLibraries="@(LolcodeLibrary)"
          SkipCompilerExecution="$(SkipCompilerExecution)" />

  </Target>

  <!-- Support dotnet watch by monitoring .lol files -->
  <ItemGroup>
    <Watch Include="**/*.lol" Exclude="$(DefaultItemExcludes)" />
  </ItemGroup>

</Project>