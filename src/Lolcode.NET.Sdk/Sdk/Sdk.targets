<!--
  Lolcode.NET.Sdk - Sdk.targets

  Imported at the BOTTOM of every .lolproj file.
  Defines CoreCompile override and imports the base .NET SDK targets.
-->
<Project>

  <!-- Import .NET SDK targets first — gives us publish, pack, clean, run, etc. -->
  <!-- Setting Language=LOLCODE means it won't find Microsoft.LOLCODE.targets, which is fine -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Resolve the compiler task assembly location -->
  <PropertyGroup>
    <_LolcodeBuildTasksDir Condition=" '$(_LolcodeBuildTasksDir)' == '' ">$(MSBuildThisFileDirectory)..\tools\net10.0\</_LolcodeBuildTasksDir>
    <LolcodeRuntimeAssemblyPath Condition=" '$(LolcodeRuntimeAssemblyPath)' == '' ">$(_LolcodeBuildTasksDir)Lolcode.Runtime.dll</LolcodeRuntimeAssemblyPath>
    <LolcodeRuntimeStringAssemblyPath Condition=" '$(LolcodeRuntimeStringAssemblyPath)' == '' ">$(_LolcodeBuildTasksDir)Lolcode.Runtime.String.dll</LolcodeRuntimeStringAssemblyPath>
    <LolcodeRuntimeStdlibAssemblyPath Condition=" '$(LolcodeRuntimeStdlibAssemblyPath)' == '' ">$(_LolcodeBuildTasksDir)Lolcode.Runtime.Stdlib.dll</LolcodeRuntimeStdlibAssemblyPath>
    <LolcodeRuntimeStdioAssemblyPath Condition=" '$(LolcodeRuntimeStdioAssemblyPath)' == '' ">$(_LolcodeBuildTasksDir)Lolcode.Runtime.Stdio.dll</LolcodeRuntimeStdioAssemblyPath>
    <LolcodeRuntimeSocksAssemblyPath Condition=" '$(LolcodeRuntimeSocksAssemblyPath)' == '' ">$(_LolcodeBuildTasksDir)Lolcode.Runtime.Socks.dll</LolcodeRuntimeSocksAssemblyPath>
    <_LolcodeCompilerOptionsFile>$(IntermediateOutputPath)Lolcode.CompilerOptions.cache</_LolcodeCompilerOptionsFile>
    <_LolcodeStaticDeployment Condition="'$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true' or '$(PublishSingleFile)' == 'true' or '$(IsAotCompatible)' == 'true' or '$(IsTrimmable)' == 'true'">true</_LolcodeStaticDeployment>
    <_LolcodeEffectiveLibraryResolution Condition="'$(LolcodeLibraryResolution)' == 'Auto' and '$(_LolcodeStaticDeployment)' == 'true'">Static</_LolcodeEffectiveLibraryResolution>
    <_LolcodeEffectiveLibraryResolution Condition="'$(LolcodeLibraryResolution)' == 'Auto' and '$(_LolcodeStaticDeployment)' != 'true'">Dynamic</_LolcodeEffectiveLibraryResolution>
    <_LolcodeEffectiveLibraryResolution Condition="'$(LolcodeLibraryResolution)' != 'Auto'">$(LolcodeLibraryResolution)</_LolcodeEffectiveLibraryResolution>
    <GenerateRuntimeConfigurationFiles Condition="'$(OutputType)' != 'Library' and '$(GenerateRuntimeConfigurationFiles)' == ''">true</GenerateRuntimeConfigurationFiles>
    <_CorePublishTargets>_ValidateLolcodeDeploymentOptions;_ValidateLolcodeDeploymentOutput;$(_CorePublishTargets)</_CorePublishTargets>
    <_PublishNoBuildAlternativeDependsOn>_ValidateLolcodeDeploymentOptions;_ValidateLolcodeDeploymentOutput;$(_PublishNoBuildAlternativeDependsOn)</_PublishNoBuildAlternativeDependsOn>
  </PropertyGroup>

  <ItemGroup Condition="'$(_LolcodeEffectiveLibraryResolution)' == 'Static'">
    <ProjectReference Update="@(ProjectReference)">
      <AdditionalProperties>%(AdditionalProperties);LolcodeLibraryResolution=Static</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Register the compiler task -->
  <UsingTask TaskName="Lolcode.Build.Lolc"
             AssemblyFile="$(_LolcodeBuildTasksDir)Lolcode.Build.dll" />
  <UsingTask TaskName="Lolcode.Build.MakeValidClrIdentifier"
             AssemblyFile="$(_LolcodeBuildTasksDir)Lolcode.Build.dll" />
  <UsingTask TaskName="Lolcode.Build.NormalizeClrNamespace"
             AssemblyFile="$(_LolcodeBuildTasksDir)Lolcode.Build.dll" />
  <UsingTask TaskName="Lolcode.Build.ValidateLolcodeDeployment"
             AssemblyFile="$(_LolcodeBuildTasksDir)Lolcode.Build.dll" />

  <!-- SDK-bundled providers remain normal runtime/reference assets. -->
  <ItemGroup>
    <Reference Include="Lolcode.Runtime">
      <HintPath>$(LolcodeRuntimeAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Lolcode.Runtime.String">
      <HintPath>$(LolcodeRuntimeStringAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Lolcode.Runtime.Stdlib">
      <HintPath>$(LolcodeRuntimeStdlibAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Lolcode.Runtime.Stdio">
      <HintPath>$(LolcodeRuntimeStdioAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Lolcode.Runtime.Socks">
      <HintPath>$(LolcodeRuntimeSocksAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <LolcodeLibrary Include="STRING|Lolcode.Runtime.String|Lolcode.Runtime.String.StringLibrary|true|1|Lolcode.Runtime.String.StringLibraryFactory" />
    <LolcodeLibrary Include="STDLIB|Lolcode.Runtime.Stdlib|Lolcode.Runtime.Stdlib.StdlibLibrary|true|1|Lolcode.Runtime.Stdlib.StdlibLibraryFactory" />
    <LolcodeLibrary Include="STDIO|Lolcode.Runtime.Stdio|Lolcode.Runtime.Stdio.StdioLibrary|true|1|Lolcode.Runtime.Stdio.StdioLibraryFactory" />
    <LolcodeLibrary Include="SOCKS|Lolcode.Runtime.Socks|Lolcode.Runtime.Socks.SocksLibrary|true|1|Lolcode.Runtime.Socks.SocksLibraryFactory" />
  </ItemGroup>

  <!--
    CreateManifestResourceNames: Required by Microsoft.Common.targets for embedded resources.
    LOLCODE doesn't have embedded resources, so this is a no-op.
  -->
  <Target Name="CreateManifestResourceNames" />

  <Target Name="_ValidateLolcodeDeploymentOptions"
          BeforeTargets="CoreCompile">
    <Error Condition="'$(_LolcodeEffectiveLibraryResolution)' != 'Dynamic' and '$(_LolcodeEffectiveLibraryResolution)' != 'Static'"
           Text="LolcodeLibraryResolution must be Auto, Dynamic, or Static." />
    <Error Condition="('$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true') and '$(_LolcodeEffectiveLibraryResolution)' == 'Dynamic'"
           Code="LOL3005"
           Text="Dynamic LOLCODE library resolution is incompatible with PublishTrimmed or PublishAot. Set LolcodeLibraryResolution=Static or remove the deployment property." />
    <Error Condition="'$(PublishSingleFile)' == 'true' and '$(_LolcodeEffectiveLibraryResolution)' == 'Dynamic' and '@(LolcodeLibrary)' != ''"
           Code="LOL3005"
           Text="Dynamic registered providers cannot be bundled with PublishSingleFile. Set LolcodeLibraryResolution=Static, or remove registered providers and deploy explicit dynamic sidecars." />
  </Target>

  <Target Name="_PrepareLolcodeLibraryTypeName">
    <MakeValidClrIdentifier Condition="'$(OutputType)' == 'Library' and '$(LolcodeLibraryTypeName)' == ''"
                            Input="$(AssemblyName)">
      <Output TaskParameter="Identifier" PropertyName="LolcodeLibraryTypeName" />
    </MakeValidClrIdentifier>

    <MakeValidClrIdentifier Condition="'$(OutputType)' == 'Library'"
                            Input="$(LolcodeLibraryTypeName)">
      <Output TaskParameter="Identifier" PropertyName="_LolcodeValidatedLibraryTypeName" />
    </MakeValidClrIdentifier>

    <Error Condition="'$(OutputType)' == 'Library' and '$(_LolcodeValidatedLibraryTypeName)' != '$(LolcodeLibraryTypeName)'"
           Text="LolcodeLibraryTypeName must be a simple, non-keyword CLR/C# identifier without dots. Set RootNamespace to the desired namespace." />

    <PropertyGroup Condition="'$(OutputType)' == 'Library'">
      <_LolcodeEffectiveRootNamespace Condition="'$(RootNamespace)' != ''">$(RootNamespace)</_LolcodeEffectiveRootNamespace>
    </PropertyGroup>

    <NormalizeClrNamespace Condition="'$(OutputType)' == 'Library' and '$(_LolcodeEffectiveRootNamespace)' != ''"
                           Input="$(_LolcodeEffectiveRootNamespace)">
      <Output TaskParameter="NormalizedNamespace" PropertyName="_LolcodeSanitizedRootNamespace" />
    </NormalizeClrNamespace>

    <PropertyGroup Condition="'$(OutputType)' == 'Library'">
      <_LolcodeLibraryFullTypeName
          Condition="'$(_LolcodeSanitizedRootNamespace)' != ''">$(_LolcodeSanitizedRootNamespace).$(LolcodeLibraryTypeName)</_LolcodeLibraryFullTypeName>
      <_LolcodeLibraryFullTypeName
          Condition="'$(_LolcodeLibraryFullTypeName)' == ''">$(LolcodeLibraryTypeName)</_LolcodeLibraryFullTypeName>
    </PropertyGroup>

    <PropertyGroup>
      <_LolcodeLibraryDescriptorStamp>@(LolcodeLibrary, ';')</_LolcodeLibraryDescriptorStamp>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_LolcodeCompilerOptionsFile)"
                      Lines="OutputType=$(OutputType);AssemblyName=$(AssemblyName);RootNamespace=$(_LolcodeSanitizedRootNamespace);LolcodeLibraryTypeName=$(LolcodeLibraryTypeName);LolcodeLibraryFullTypeName=$(_LolcodeLibraryFullTypeName);LolcodeLibraries=$(_LolcodeLibraryDescriptorStamp);LolcodeLibraryResolution=$(_LolcodeEffectiveLibraryResolution);PublishAot=$(PublishAot);PublishTrimmed=$(PublishTrimmed);PublishSingleFile=$(PublishSingleFile);RuntimeIdentifier=$(RuntimeIdentifier)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="_ValidateLolcodeDeploymentOutput"
          Condition="'$(_LolcodeStaticDeployment)' == 'true'">
    <ValidateLolcodeDeployment
        AssemblyPath="$(IntermediateOutputPath)$(TargetName)$(TargetExt)"
        ExpectedLibraryResolution="$(_LolcodeEffectiveLibraryResolution)" />
  </Target>

  <!--
    Override CoreCompile — this is the target called by the .NET SDK to compile source code.
    We replace the default C# Csc task with our Lolc task.

    Inputs/Outputs enable incremental builds: MSBuild skips this target if all
    outputs are newer than all inputs.
  -->
  <Target Name="CoreCompile"
          Condition=" '@(Compile)' != '' "
          DependsOnTargets="_PrepareLolcodeLibraryTypeName;$(CoreCompileDependsOn)"
          Inputs="@(Compile);@(CustomAdditionalCompileInputs);@(ReferencePathWithRefAssemblies);$(MSBuildAllProjects);$(_LolcodeCompilerOptionsFile)"
          Outputs="@(IntermediateAssembly)">

    <!-- Filter out any non-.lol files (e.g., auto-generated .cs files from file-based apps) -->
    <ItemGroup>
      <_LolSources Include="@(Compile)" Condition="'%(Extension)' == '.lol'" />
    </ItemGroup>

    <Lolc Sources="@(_LolSources)"
          ReferencePath="@(ReferencePathWithRefAssemblies)"
          OutputAssembly="@(IntermediateAssembly)"
          RuntimeAssemblyPath="$(LolcodeRuntimeAssemblyPath)"
          OutputType="$(OutputType)"
          AssemblyName="$(AssemblyName)"
          LolcodeLibraryTypeName="$(_LolcodeLibraryFullTypeName)"
          LolcodeLibraries="@(LolcodeLibrary)"
          LibraryResolution="$(_LolcodeEffectiveLibraryResolution)"
          RuntimeConfigOwnedByHost="true"
          SkipCompilerExecution="$(SkipCompilerExecution)" />

  </Target>

  <Target Name="_ValidateLolcodeSingleBinaryPublish"
          AfterTargets="Publish"
          Condition="'$(LolcodeRequireSingleBinary)' == 'true'">
    <ItemGroup>
      <_LolcodeManagedPublishSidecar Include="$(PublishDir)**/*.dll" />
      <_LolcodeManagedPublishSidecar Include="$(PublishDir)**/*.deps.json" />
      <_LolcodeManagedPublishSidecar Include="$(PublishDir)**/*.runtimeconfig.json" />
    </ItemGroup>
    <Error Condition="'@(_LolcodeManagedPublishSidecar)' != ''"
           Code="LOL3008"
           Text="LolcodeRequireSingleBinary requires no managed DLL, deps.json, or runtimeconfig.json publish sidecars. Found: @(_LolcodeManagedPublishSidecar)." />
  </Target>

  <!-- Support dotnet watch by monitoring .lol files -->
  <ItemGroup>
    <Watch Include="**/*.lol" Exclude="$(DefaultItemExcludes)" />
  </ItemGroup>

</Project>