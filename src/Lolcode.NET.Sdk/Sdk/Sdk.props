<!--
  Lolcode.NET.Sdk - Sdk.props

  Imported at the TOP of every .lolproj file.
  Sets language defaults and imports the base .NET SDK.
-->
<Project>

  <!-- Import .NET SDK props first — gives us TFM, OutputType, reference resolution, etc. -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <!-- Identify this as a LOLCODE project -->
    <Language>LOLCODE</Language>
    <DefaultLanguageSourceExtension>.lol</DefaultLanguageSourceExtension>

    <!-- Disable C# specific features that don't apply -->
    <DisableRoslynAnalyzers>true</DisableRoslynAnalyzers>

    <!-- Disable reference assembly generation (not needed for LOLCODE) -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <!-- Disable auto-generated C# files (GlobalUsings.g.cs, AssemblyAttributes.cs) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <LolcodeUseDefaultLibraries Condition="'$(LolcodeUseDefaultLibraries)' == ''">true</LolcodeUseDefaultLibraries>
    <LolcodeRuntimePackageVersion Condition="'$(LolcodeRuntimePackageVersion)' == ''">0.3.0</LolcodeRuntimePackageVersion>
  </PropertyGroup>

  <!-- Provider packages are normal restore inputs so their runtime dependencies
       flow through LOLCODE libraries to a final managed host. -->
  <ItemGroup Condition="'$(LolcodeUseDefaultLibraries)' == 'true' and '$(LolcodeUseSourceLibraries)' != 'true'">
    <PackageReference Include="Lolcode.Runtime.String" Version="$(LolcodeRuntimePackageVersion)" IsImplicitlyDefined="true" />
    <PackageReference Include="Lolcode.Runtime.Stdlib" Version="$(LolcodeRuntimePackageVersion)" IsImplicitlyDefined="true" />
    <PackageReference Include="Lolcode.Runtime.Stdio" Version="$(LolcodeRuntimePackageVersion)" IsImplicitlyDefined="true" />
    <PackageReference Include="Lolcode.Runtime.Socks" Version="$(LolcodeRuntimePackageVersion)" IsImplicitlyDefined="true" />
  </ItemGroup>

  <!-- Disable default C# compile globbing, then add LOLCODE glob -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.lol" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>

  <!-- Make .lol files visible in Solution Explorer with correct build action -->
  <ItemGroup>
    <AvailableItemName Include="LolcodeCompile" />
  </ItemGroup>

</Project>