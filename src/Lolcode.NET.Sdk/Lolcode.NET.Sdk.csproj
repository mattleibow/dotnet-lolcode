<!-- Lolcode.NET.Sdk.csproj — Produces the MSBuild SDK NuGet package -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <PackageType>MSBuildSdk</PackageType>
    <PackageId>Lolcode.NET.Sdk</PackageId>
    <PackageDescription>MSBuild SDK for compiling LOLCODE 1.2 programs to .NET assemblies. Use with Project Sdk="Lolcode.NET.Sdk" in .lolproj files.</PackageDescription>
    <PackageTags>lolcode;compiler;msbuild;sdk;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mattleibow/dotnet-lolcode</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <!-- SDK entry points (Sdk/Sdk.props + Sdk/Sdk.targets) -->
  <ItemGroup>
    <Content Include="Sdk\Sdk.targets" PackagePath="Sdk\Sdk.targets" />
    <Content Include="Sdk\Sdk.props" PackagePath="Sdk\Sdk.props" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- MSBuild task and compiler (build-time tool dependencies) -->
  <ItemGroup>
    <TfmSpecificPackageFile Include="..\Lolcode.Build\bin\$(Configuration)\net10.0\Lolcode.Build.dll" PackagePath="tools/net10.0/Lolcode.Build.dll" />
    <TfmSpecificPackageFile Include="..\Lolcode.Build\bin\$(Configuration)\net10.0\Lolcode.Build.deps.json" PackagePath="tools/net10.0/Lolcode.Build.deps.json" />
    <TfmSpecificPackageFile Include="..\Lolcode.Build\bin\$(Configuration)\net10.0\Lolcode.CodeAnalysis.dll" PackagePath="tools/net10.0/Lolcode.CodeAnalysis.dll" />
    <TfmSpecificPackageFile Include="..\Lolcode.Build\bin\$(Configuration)\net10.0\Lolcode.Runtime.dll" PackagePath="tools/net10.0/Lolcode.Runtime.dll" />
    <TfmSpecificPackageFile Include="..\Lolcode.Build\bin\$(Configuration)\net10.0\System.Reflection.MetadataLoadContext.dll" PackagePath="tools/net10.0/System.Reflection.MetadataLoadContext.dll" />
  </ItemGroup>

  <!-- Ensure dependencies are built first -->
  <ItemGroup>
    <ProjectReference Include="..\Lolcode.Build\Lolcode.Build.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>