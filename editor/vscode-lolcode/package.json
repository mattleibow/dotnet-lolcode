{
  "name": "vscode-lolcode",
  "displayName": "LOLCODE",
  "description": "Syntax highlighting and editing support for LOLCODE.",
  "version": "0.1.0",
  "publisher": "mattleibow",
  "main": "./extension.js",
  "license": "MIT",
  "icon": "assets/lolcode-icon.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "pricing": "Free",
  "homepage": "https://github.com/mattleibow/dotnet-lolcode/tree/main/editor/vscode-lolcode",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattleibow/dotnet-lolcode.git",
    "directory": "editor/vscode-lolcode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lolcode",
    "syntax highlighting",
    "textmate",
    "dotnet",
    "compiler",
    "esolang"
  ],
  "scripts": {
    "test": "node --test ./test/validate-extension.cjs"
  },
  "activationEvents": [
    "onCommand:lolcode.installTemplates"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lolcode",
        "aliases": [
          "LOLCODE",
          "lolcode"
        ],
        "extensions": [
          ".lol"
        ],
        "firstLine": "^#!.*\\bdotnet\\s+run\\s+--file\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lolcode",
        "scopeName": "source.lolcode",
        "path": "./syntaxes/lolcode.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lolcode",
        "path": "./snippets/lolcode.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "lolcode.installTemplates",
        "title": "LOLCODE: Install .NET Templates"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "lolcode.installTemplates"
        }
      ]
    }
  }
}
