<Project>
  <Import Project="../../../../src/Lolcode.NET.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GameEngine</AssemblyName>
    <RootNamespace>GameEngine</RootNamespace>
    <LolcodeLibraryTypeName>EngineExports</LolcodeLibraryTypeName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**/*.lol" />
    <Compile Include="01-Collections.lol" />
    <Compile Include="02-Commands.lol" />
    <Compile Include="03-Determinism.lol" />
  </ItemGroup>
  <Import Project="../../../../src/Lolcode.NET.Sdk/Sdk/Sdk.targets" />
</Project>
