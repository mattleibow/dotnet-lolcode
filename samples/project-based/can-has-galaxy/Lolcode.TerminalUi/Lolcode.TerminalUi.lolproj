<Project>
  <Import Project="../../../../src/Lolcode.NET.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TerminalUi</AssemblyName>
    <RootNamespace>TerminalUi</RootNamespace>
    <LolcodeLibraryTypeName>UiExports</LolcodeLibraryTypeName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**/*.lol" />
    <Compile Include="01-Text.lol" />
    <Compile Include="02-Widgets.lol" />
  </ItemGroup>
  <Import Project="../../../../src/Lolcode.NET.Sdk/Sdk/Sdk.targets" />
</Project>
