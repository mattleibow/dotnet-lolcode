<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Lolcode.EndToEnd.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lolcode.Build\Lolcode.Build.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Lolcode.CodeAnalysis\Lolcode.CodeAnalysis.csproj" />
    <ProjectReference Include="..\..\src\Lolcode.Runtime\Lolcode.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../externals/lci/COPYING"
          Link="Conformance/lci/upstream/COPYING"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../externals/lci/cmake/**/*"
          Link="Conformance/lci/upstream/cmake/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../externals/lci/test/**/*"
          Link="Conformance/lci/upstream/test/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
