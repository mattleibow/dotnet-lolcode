<Project>
  <Import Project="../../src/Lolcode.NET.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NativeAotFixture</AssemblyName>
    <LolcodeUseDefaultLibraries>false</LolcodeUseDefaultLibraries>
    <LolcodeUseSourceLibraries>true</LolcodeUseSourceLibraries>
    <LolcodeLibraryResolution>Dynamic</LolcodeLibraryResolution>
    <_LolcodeBuildTasksDir>$(MSBuildThisFileDirectory)..\..\src\Lolcode.Build\bin\$(Configuration)\net10.0\</_LolcodeBuildTasksDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Lolcode.Build/Lolcode.Build.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;SelfContained;RuntimeIdentifier;IsAotCompatible;IsTrimmable" />
  </ItemGroup>
  <Import Project="../../src/Lolcode.NET.Sdk/Sdk/Sdk.targets" />
</Project>
